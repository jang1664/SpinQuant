    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1",
   "metadata": {},
   "outputs": [],
   "source": [
    "for i in range(100000):\n",
    "  a = np.random.rand(1)[0].astype(np.float16)\n",
    "  b = np.random.rand(1)[0].astype(np.float16)\n",
    "  c = a * b\n",
    "  d = np.float16(np.float32(a) * np.float32(b))\n",
    "  if c != d:\n",
    "    print(f\"Mismatch: {a} * {b} = {c} (expected {d})\")\n"
   ]
  },
